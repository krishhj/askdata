GROQ_API_KEY=your-groq-api-key

# Session pooler URLs. Copy the host from Supabase, then change the scheme to postgresql+psycopg://
# Custom roles log in as role_name.project_ref. URL-encode special characters in passwords.
ADMIN_DB_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
READER_DB_URL=postgresql+psycopg://askdata_reader.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
FEEDBACK_DB_URL=postgresql+psycopg://askdata_feedback.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
